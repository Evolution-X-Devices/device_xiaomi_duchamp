<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="tweaks_screen"
    android:title="@string/tweaks_button_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="tweaks_header"
        android:layout="@layout/tweaks_header_card"
        settings:allowDividerBelow="true" />

    <PreferenceCategory
        android:key="wakelock_blocker_category"
        android:title="@string/wakelock_blocker_category_title">

        <Preference
            android:key="wakelock_blocker_apps"
            android:title="@string/wakelock_blocker_per_app_title"
            android:summary="@string/wakelock_blocker_per_app_summary" />

        <Preference
            android:key="wakelock_blocker_kernel"
            android:title="@string/wakelock_blocker_kernel_title"
            android:summary="@string/wakelock_blocker_kernel_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="tcp_congestion_category"
        android:title="@string/tcp_congestion_category_title">

        <ListPreference
            android:key="tcp_congestion_control"
            android:title="@string/tcp_congestion_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="zram_category"
        android:title="@string/zram_category_title">

        <ListPreference
            android:key="zram_recomp_algorithm"
            android:title="@string/zram_recomp_algorithm_title" />

        <Preference
            android:key="zram_recompress"
            android:title="@string/zram_recompress_title"
            android:summary="@string/zram_recompress_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="wq_category"
        android:title="@string/wq_category_title">

        <androidx.preference.SwitchPreferenceCompat
            android:key="wq_power_efficient"
            android:title="@string/wq_power_efficient_title"
            android:summary="@string/wq_power_efficient_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="logging_category"
        android:title="@string/logging_category_title">

        <ListPreference
            android:key="kernel_printk_level"
            android:title="@string/kernel_printk_level_title" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="tweaks_info"
        android:title="@string/tweaks_title" />

</PreferenceScreen>
