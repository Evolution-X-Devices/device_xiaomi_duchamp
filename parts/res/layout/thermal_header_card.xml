<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thermal_header_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/thermal_header_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_thermal"
        android:background="@drawable/circle_bg"
        android:padding="20dp" />

    <TextView
        android:id="@+id/thermal_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/thermal_profile_balanced"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/thermal_profile_active_subtitle"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />
</LinearLayout>
