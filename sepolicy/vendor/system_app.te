hal_client_domain(system_app, hal_mlipay)
hal_client_domain(system_app, vendor_hal_displayfeature)

# Thermals
allow system_app sysfs_therm:dir search;
allow system_app sysfs_therm:file rw_file_perms;

# HTSR
allow system_app vendor_sysfs_touch:dir search;
allow system_app vendor_sysfs_touch:file rw_file_perms;

# Wakelock Blocker
allow system_app vendor_sysfs_wakelock_blocker:dir search;
allow system_app vendor_sysfs_wakelock_blocker:file rw_file_perms;
r_dir_file(system_app, sysfs_wakeup)

# TCP
allow system_app proc_net:dir search;
allow system_app proc_net:file rw_file_perms;

# ZRAM
allow system_app sysfs_zram:dir search;
allow system_app sysfs_zram:file rw_file_perms;

# Workqueue
allow system_app vendor_sysfs_workqueue:file rw_file_perms;

# Printk
allow system_app vendor_proc_printk:file rw_file_perms;

# Battery
allow system_app sysfs_batteryinfo:dir search;
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;





